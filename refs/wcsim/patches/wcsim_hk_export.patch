@@ -17,6 +17,7 @@
 #include "G4PVPlacement.hh"
 #include "G4PVParameterised.hh"
 #include "G4AssemblyVolume.hh"
+#include "G4AssemblyStore.hh"   // lumen refs (GDML export only)
 #include "G4SubtractionSolid.hh"
 #include "globals.hh"
 #include "G4VisAttributes.hh"
@@ -1284,6 +1285,17 @@ G4LogicalVolume* WCSimDetectorConstruction::ConstructRealisticPlacement()
 
     G4cout << "Final Values : " << pmt20_count_final << " " << pmtmulti_count_final << " " << pmtod_count_final << G4endl;
 
+    // lumen refs (GDML export only): the assemblies are deregistered (not deleted), so the GDML writer emits their
+    // imprints as the ordinary physical volumes they are. Its assembly support reads G4AssemblyStore, whose assemblies
+    // still list the dummy PMT placements deleted above (and may alias new placements at reused addresses): the writer
+    // crashed (std::length_error / std::bad_alloc in "Writing structure"). The geometry is unchanged.
+    {
+      std::vector<G4AssemblyVolume*> assemblies(G4AssemblyStore::GetInstance()->begin(),
+                                                G4AssemblyStore::GetInstance()->end());
+      for (auto a : assemblies) G4AssemblyStore::DeRegister(a);
+      G4cout << "lumen refs: " << assemblies.size() << " assemblies deregistered for the GDML export" << G4endl;
+    }
+
     G4cout << "FINISHED Realistic Placement" << G4endl;
 
     return rockShellLogic;

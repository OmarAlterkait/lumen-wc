diff --git a/src/WCSimConstructMultiPMT.cc b/src/WCSimConstructMultiPMT.cc
index 6aeb3ff..8daa037 100644
--- a/src/WCSimConstructMultiPMT.cc
+++ b/src/WCSimConstructMultiPMT.cc
@@ -512,14 +512,16 @@ G4LogicalVolume* WCSimDetectorConstruction::ConstructMultiPMT(G4String PMTName,
   // TF: cut in pieces is better for different OD/ID types. But different parametrization objects needed?
 
   
-  G4VPhysicalVolume* hemisphere = 
-    new G4PVParameterised("pmt",                            // their name
-			  logicWCPMT,                       // their logical volume
-			  logic_mPMT_container,             // Mother logical volume
-			  kZAxis,                           // Are placed along this axis
-			  NbOfTotPmt,                       // Number of PMTs (replica's)
-			  pmtParam_id,                      // The parametrisation
-			  checkOverlaps);                   // checking overlaps
+  // lumen refs (GDML export only): the PMTs as plain placements, each at the parameterisation's own transformation
+  // (WCSimMultiPMTParameterisation::ComputeTransformation), copy number = the parameterised copy number, so the GDML
+  // writer emits physvols instead of a paramvol. The hits runs use WCSim unpatched (G4PVParameterised).
+  G4VPhysicalVolume* hemisphere = 0;
+  for (G4int copy = 0; copy < NbOfTotPmt; copy++) {
+    G4VPhysicalVolume* pv = new G4PVPlacement(0, G4ThreeVector(), logicWCPMT, "pmt", logic_mPMT_container,
+                                              false, copy, false);   // overlaps: checked below, after the transformation
+    pmtParam_id->ComputeTransformation(copy, pv);
+    if (copy == 0) hemisphere = pv;
+  }
   
   
   // Need a 4mm tolerance : still not perfect though because overlaps with mother volume happen still..
diff --git a/src/WCSimConstructRealisticPlacement.cc b/src/WCSimConstructRealisticPlacement.cc
